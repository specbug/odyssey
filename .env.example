# Copy this file to .env and fill in the values

# Production origins allowed by FastAPI CORS (comma-separated)
# Replace with your actual subdomain once the tunnel is live
CORS_ORIGINS=https://odyssey.sixeleven.in

# Cloudflare Tunnel token — get this from:
# Cloudflare Zero Trust dashboard → Networks → Tunnels → Create a tunnel
# Set the tunnel ingress rule: https://odyssey.sixeleven.in → http://web:80
CLOUDFLARE_TUNNEL_TOKEN=your_tunnel_token_here

# LLM metadata enrichment (optional) — Meta Model API
# When set, uploaded PDFs get title / author / excerpt auto-extracted from
# their first pages' text. Leave unset to disable — the backend degrades
# gracefully.
# Get a key: https://dev.meta.ai (API keys page of your team)
META_API_KEY=
# Default is the Contributor tier (muse-spark-1.3-contributor): very cheap,
# but Meta may train on the prompts — i.e. the opening pages of your PDFs.
# Use muse-spark-1.3 for the Standard tier (not trained on, ~12x the price).
# META_MODEL=muse-spark-1.3-contributor

# Automatic note linking (optional; needs META_API_KEY). A background worker
# reads your notes and links genuinely related ones into the Graph screen.
# It sends note text to the Meta API — on the Contributor tier, Meta may train
# on it. Set false to keep metadata enrichment but stop linking.
# LINKER_ENABLED=true
# Use a different model for linking only (e.g. muse-spark-1.3, the Standard
# tier). Empty → same as META_MODEL.
# META_LINK_MODEL=

# Healthchecks.io push heartbeat (optional)
# When set, the api pings this URL every 60s. Silence triggers an alert.
# Sign up: https://healthchecks.io (free for personal use)
# Create a check → copy its ping URL (looks like https://hc-ping.com/<uuid>)
# Leave unset to disable heartbeat monitoring.
HEALTHCHECKS_URL=
