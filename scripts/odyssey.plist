<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>in.sixeleven.odyssey</string>

    <!-- Points at an installed copy outside ~/Documents so launchd isn't blocked by macOS TCC.
         Source of truth is scripts/start.sh; re-copy to ~/.local/bin/odyssey-start on change. -->
    <key>ProgramArguments</key>
    <array>
        <string>/Users/rishitv/.local/bin/odyssey-start</string>
    </array>

    <!-- Run at every login -->
    <key>RunAtLoad</key>
    <true/>

    <!-- Don't restart the launcher itself; compose handles container restarts -->
    <key>KeepAlive</key>
    <false/>

    <!-- CRITICAL: `podman machine start` spawns vfkit (the VM) as a child.
         Without this key, launchd reaps the entire process group when our
         short-lived script exits — killing vfkit and collapsing the stack
         seconds after we just brought it up. This flag tells launchd to
         leave our children alone. Documented in podman's own macOS autostart
         docs; without it any LaunchAgent-based setup is structurally broken. -->
    <key>AbandonProcessGroup</key>
    <true/>

    <!-- Watchdog: re-run every 2 min. Script is idempotent and silent when healthy;
         it (a) starts the podman machine if down, (b) brings the stack up if down,
         (c) probes /health and restarts the api container if it's wedged. -->
    <key>StartInterval</key>
    <integer>120</integer>

    <key>StandardOutPath</key>
    <string>/Users/rishitv/Library/Logs/odyssey.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/rishitv/Library/Logs/odyssey-error.log</string>

    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
        <key>HOME</key>
        <string>/Users/rishitv</string>
    </dict>
</dict>
</plist>
